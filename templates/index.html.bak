<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Developer Zone | Anurag Singh</title><style>body{margin:0;background:#090f20;color:#f4f7ff;font-family:system-ui,Arial}main{max-width:880px;margin:50px auto;padding:20px}.badge{color:#5eead4;letter-spacing:3px;font-weight:700}.card{background:#151e35;border:1px solid #30415f;border-radius:18px;padding:24px;margin:15px 0;box-shadow:0 12px 35px #0004}h1{font-size:clamp(34px,6vw,62px);margin:12px 0;background:linear-gradient(90deg,#64e9ff,#b991ff);background-clip:text;color:transparent}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}.label{color:#aab8d6;font-size:13px}.value{font-size:25px;font-weight:700;margin-top:8px}a{color:#79dfff}.note{color:#acbad4;font-size:13px}</style></head><body><main><div class="badge">● LOCAL CONTROL PANEL</div><h1>Developer Zone</h1><p>Created by <b>Anurag Singh</b> · Telegram <a href="https://t.me/Developer_NovaG">@Developer_NovaG</a></p><div class="card"><h2>Session Configuration</h2><div class="grid"><div><div class="label">Region</div><div class="value" id="region">—</div></div><div><div class="label">Bots</div><div class="value" id="bots">—</div></div><div><div class="label">Parallel limit / bot</div><div class="value" id="parallel_per_bot">—</div></div><div><div class="label">Guild ID</div><div class="value" id="guild">—</div></div></div></div><p class="note">Configuration dashboard only. Match status and game server acceptance are not verified here. Refreshes every 3 seconds.</p></main><script>async function refresh(){try{let r=await fetch('/status',{cache:'no-store'}),d=await r.json();for(let k of ['region','bots','guild','parallel_per_bot'])document.getElementById(k).textContent=d[k]??'—'}catch(e){}}refresh();setInterval(refresh,3000)</script></body></html>